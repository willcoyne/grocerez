# Copy to deploy/.env on the Linode (cp .env.example .env; chmod 600 .env). Never commit deploy/.env.
# Generate secrets with: openssl rand -hex 32   (hex only: these go into connection URLs, so avoid / @ : # characters)

# ── Host ───────────────────────────────────────────────────────────────────────
# Public hostname that resolves to this box (Caddy gets the TLS cert for it). No scheme.
DOMAIN=pantry.example.com

# ── Postgres ───────────────────────────────────────────────────────────────────
# Owner role "grocerez" (migrations, seed) and least-privilege runtime role "grocerez_app" (the API).
POSTGRES_PASSWORD=change-me-hex
GROCEREZ_APP_PASSWORD=change-me-hex

# ── API server ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-hex
# Web, iOS and Android OAuth client IDs, comma-separated.
GOOGLE_CLIENT_IDS=web-id.apps.googleusercontent.com,ios-id.apps.googleusercontent.com,android-id.apps.googleusercontent.com
APP_LINK_BASE=grocerez://
CONTACT_EMAIL=team@grocerez.app
# Optional: enables POST /api/dev/login-as with header x-demo-key (for judging).
DEMO_KEY=
OPENFDA_API_KEY=
RESEND_API_KEY=
RESEND_FROM=GrocerEZ <invites@your-verified-domain.com>

# ── Pantry agent ───────────────────────────────────────────────────────────────
# Shared by server and agent. Server rejects values under 32 chars.
AGENT_SHARED_SECRET=change-me-hex
# akamai | anthropic | bedrock
AGENT_PROVIDER=akamai
PRICE_PROVIDER=akamai
# Akamai hosted inference (OpenAI-compatible); team credentials from the Akamai table at kickoff.
AKAMAI_INFERENCE_URL=https://ws.akamai-workshops.com/v1
AKAMAI_INFERENCE_KEY=
AKAMAI_MODEL=hackathon-chat
AKAMAI_ENABLE_THINKING=false
# Recipe web search for the agent (Tavily). Empty → model-written recipes, labeled "AI-created".
TAVILY_API_KEY=
AKAMAI_IMAGE_MODEL=hackathon-image
AKAMAI_EMBEDDING_MODEL=hackathon-embedding
# Required by the server in production and used as the agent fallback provider.
ANTHROPIC_API_KEY=sk-ant-placeholder
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_MAX_TOOL_CALLS=25
AGENT_RUN_TIMEOUT_S=105

# ── Akamai Object Storage (S3-compatible) ──────────────────────────────────────
# Endpoint format: https://<cluster-id>.linodeobjects.com  (us-ord cluster id is us-ord-1)
S3_ENDPOINT=https://us-ord-1.linodeobjects.com
AWS_REGION=us-ord
S3_BUCKET=grocerez-uploads
# Object Storage access key (Cloud Manager > Object Storage > Access Keys), limited to the bucket (read/write).
AWS_ACCESS_KEY_ID=placeholder-access-key
AWS_SECRET_ACCESS_KEY=placeholder-secret-key
