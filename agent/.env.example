# GrocerEZ Pantry Agent (plan/challenges/01-pantry-agent). Copy to agent/.env; never commit agent/.env.

# ── Model providers ────────────────────────────────────────────────────────────
# Planner (tool-calling) and price sub-agent: akamai | anthropic | bedrock
AGENT_PROVIDER=akamai
PRICE_PROVIDER=akamai

# Akamai hosted inference (OpenAI-compatible). Team credentials from the Akamai table at kickoff.
AKAMAI_INFERENCE_URL=https://ws.akamai-workshops.com/v1
AKAMAI_INFERENCE_KEY=
AKAMAI_MODEL=hackathon-chat
# Also on the same endpoint (challenges 02/03):
AKAMAI_IMAGE_MODEL=hackathon-image
AKAMAI_EMBEDDING_MODEL=hackathon-embedding

# Fallback provider (only needed when AGENT_PROVIDER/PRICE_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Server link ────────────────────────────────────────────────────────────────
# Must equal AGENT_SHARED_SECRET in server/.env. Generate with: openssl rand -hex 32
AGENT_SHARED_SECRET=

# ── Run limits ─────────────────────────────────────────────────────────────────
AGENT_MAX_TOOL_CALLS=25
AGENT_RUN_TIMEOUT_S=90
PORT=8000
