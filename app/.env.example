# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (they are not secrets).

# API base URL including /api. On a phone use your laptop's LAN IP, e.g. http://192.168.1.20:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Google Cloud Console OAuth clients (plan/backend/02-auth step 1).
# The web client ID is the ID-token audience the backend accepts (server GOOGLE_CLIENT_IDS).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd (used by the google-signin config plugin at prebuild)
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Optional: show the "Demo users" list on the sign-in screen outside __DEV__ (the server must have DEMO_KEY set to the same value).
EXPO_PUBLIC_DEMO_KEY=
