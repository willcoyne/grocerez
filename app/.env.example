# Copy to .env and fill in. Never commit .env.

# API base URL. While developing, use your laptop's LAN IP (not localhost) so a phone can reach it.
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api

# 1 = use the in-memory mock API (src/api/mock) instead of the server. `npm run mock` sets it for you.
EXPO_PUBLIC_USE_MOCK=0

# Google OAuth client IDs from Google Cloud Console (see plan/backend/02-auth step 1).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd. Used at build time only.
GOOGLE_IOS_URL_SCHEME=
