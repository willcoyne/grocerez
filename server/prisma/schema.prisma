// Owned by plan/database. Models are added by the database folders.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, fuzzystrmatch]
}

// database/02-users
enum Allergen {
  milk
  eggs
  fish
  shellfish
  tree_nuts
  peanuts
  wheat
  soy
  sesame
  gluten

  @@map("allergen")
}

model User {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  googleSub     String             @unique @map("google_sub")
  email         String             @unique // lower-cased by the app
  displayName   String             @map("display_name")
  avatarUrl     String?            @map("avatar_url")
  avatarKey     String?            @map("avatar_s3_key") // backend/11; presigned into the API's avatarUrl
  zipCode       String?            @map("zip_code")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  allergens     UserAllergen[]
  diets         UserDiet[]
  groupsCreated Group[]            @relation("GroupCreator")
  memberships   GroupMember[]
  invitesSent   GroupInvite[]
  itemsCreated  Item[]
  cabinetAdded  CabinetItem[]
  listChecked   ShoppingListItem[] @relation("ListCheckedBy")
  listAdded     ShoppingListItem[] @relation("ListAddedBy")

  @@map("users")
}

model UserAllergen {
  userId   String   @map("user_id") @db.Uuid
  allergen Allergen
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, allergen])
  @@map("user_allergens")
}

// diet is CHECK-constrained in SQL (see users_profile migration).
model UserDiet {
  userId String @map("user_id") @db.Uuid
  diet   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, diet])
  @@map("user_diets")
}

// database/03-groups-invites
enum GroupRole {
  owner
  member

  @@map("group_role")
}

enum InviteStatus {
  pending
  accepted
  declined
  revoked

  @@map("invite_status")
}

model Group {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdBy String?            @map("created_by") @db.Uuid
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  creator   User?              @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  members   GroupMember[]
  invites   GroupInvite[]
  cabinet   CabinetItem[]
  list      ShoppingListItem[]

  @@map("groups")
}

model GroupMember {
  groupId     String       @map("group_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  role        GroupRole    @default(member)
  joinedAt    DateTime     @default(now()) @map("joined_at") @db.Timestamptz
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences Preference[]

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// email is CHECK-constrained to lower case in SQL (see groups_and_invites migration).
model GroupInvite {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     String       @map("group_id") @db.Uuid
  email       String
  invitedBy   String?      @map("invited_by") @db.Uuid
  status      InviteStatus @default(pending)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  respondedAt DateTime?    @map("responded_at") @db.Timestamptz
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter     User?        @relation(fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([groupId, email])
  @@index([email, status])
  @@map("group_invites")
}

// database/04-item-catalog-fuzzy-matching. normalize_item_name() and the category CHECK live in the migration SQL.
model Item {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  normalizedName   String             @unique @map("normalized_name")
  category         String?
  defaultAllergens Allergen[]         @default([]) @map("default_allergens")
  shelfLifeDays    Int?               @map("shelf_life_days")
  createdBy        String?            @map("created_by") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz
  creator          User?              @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  aliases          ItemAlias[]
  preferences      Preference[]
  cabinetItems     CabinetItem[]
  listItems        ShoppingListItem[]

  @@index([normalizedName(ops: raw("gin_trgm_ops"))], map: "items_name_trgm", type: Gin)
  @@map("items")
}

model ItemAlias {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId          String @map("item_id") @db.Uuid
  aliasNormalized String @unique @map("alias_normalized")
  item            Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([aliasNormalized(ops: raw("gin_trgm_ops"))], map: "item_aliases_trgm", type: Gin)
  @@map("item_aliases")
}

// database/05-preferences
enum Recurrence {
  staple
  one_time

  @@map("recurrence")
}

// FK (group_id, user_id) -> group_members ON DELETE CASCADE: leaving/removal deletes the member's preferences.
model Preference {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId      String      @map("group_id") @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  itemId       String      @map("item_id") @db.Uuid
  quantityText String?     @map("quantity_text")
  recurrence   Recurrence  @default(staple)
  note         String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  member       GroupMember @relation(fields: [groupId, userId], references: [groupId, userId], onDelete: Cascade)
  item         Item        @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([groupId, userId, itemId])
  @@index([groupId, itemId])
  @@map("preferences")
}

// database/06-cabinet. location is CHECK-constrained in SQL; product_id gets its FK in database/08.
enum StockStatus {
  in_stock
  running_low

  @@map("stock_status")
}

enum ExpirationSource {
  manual
  estimated

  @@map("expiration_source")
}

model CabinetItem {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId          String            @map("group_id") @db.Uuid
  itemId           String            @map("item_id") @db.Uuid
  productId        String?           @map("product_id") @db.Uuid
  status           StockStatus       @default(in_stock)
  quantityText     String?           @map("quantity_text")
  location         String?
  purchasedAt      DateTime?         @map("purchased_at") @db.Timestamptz
  expiresAt        DateTime?         @map("expires_at") @db.Date
  expirationSource ExpirationSource? @map("expiration_source")
  photoKey         String?           @map("photo_s3_key") // backend/11; presigned into the API's photoUrl
  addedBy          String?           @map("added_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  group            Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  item             Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  adder            User?             @relation(fields: [addedBy], references: [id], onDelete: SetNull)

  @@unique([groupId, itemId])
  @@index([groupId, expiresAt])
  @@map("cabinet_items")
}

// database/07-shopping-list. scanned_product_id gets its FK to products when database/08 lands.
enum ListReason {
  preference
  manual

  @@map("list_reason")
}

model ShoppingListItem {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId          String     @map("group_id") @db.Uuid
  itemId           String     @map("item_id") @db.Uuid
  reason           ListReason
  wantedBy         String[]   @default([]) @map("wanted_by") @db.Uuid
  quantityText     String?    @map("quantity_text")
  allergenFlags    Json       @default("[]") @map("allergen_flags")
  checked          Boolean    @default(false)
  checkedBy        String?    @map("checked_by") @db.Uuid
  checkedAt        DateTime?  @map("checked_at") @db.Timestamptz
  scannedProductId String?    @map("scanned_product_id") @db.Uuid
  addedBy          String?    @map("added_by") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  group            Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  item             Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  checker          User?      @relation("ListCheckedBy", fields: [checkedBy], references: [id], onDelete: SetNull)
  adder            User?      @relation("ListAddedBy", fields: [addedBy], references: [id], onDelete: SetNull)

  @@unique([groupId, itemId])
  @@index([groupId, checked])
  @@map("shopping_list_items")
}
