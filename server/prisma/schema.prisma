generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, pg_trgm, fuzzystrmatch]
}

// ─── 02 Users, diets & allergens ───────────────────────────────────────────────

/// 9 major U.S. allergens + gluten.
enum Allergen {
  milk
  eggs
  fish
  shellfish
  tree_nuts
  peanuts
  wheat
  soy
  sesame
  gluten

  @@map("allergen")
}

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Google's stable user ID (`sub` claim). Never key on email.
  googleSub   String   @unique @map("google_sub")
  /// Google-verified email, lower-cased and trimmed (CHECK enforced).
  email       String   @unique
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  zipCode     String?  @map("zip_code")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  allergens      UserAllergen[]
  diets          UserDiet[]
  groupsCreated  Group[]        @relation("GroupCreatedBy")
  memberships    GroupMember[]
  invitesSent    GroupInvite[]  @relation("InviteInvitedBy")

  @@map("users")
}

model UserAllergen {
  userId   String   @map("user_id") @db.Uuid
  allergen Allergen
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, allergen])
  @@map("user_allergens")
}

/// `diet` is CHECK-constrained to: vegetarian, vegan, pescatarian, keto, halal, kosher, low_sodium, dairy_free, gluten_free.
model UserDiet {
  userId String @map("user_id") @db.Uuid
  diet   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, diet])
  @@map("user_diets")
}

// ─── 03 Groups, members & email invites ────────────────────────────────────────

enum GroupRole {
  owner
  member

  @@map("group_role")
}

enum InviteStatus {
  pending
  accepted
  declined
  revoked

  @@map("invite_status")
}

model Group {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  /// Nullable so deleting the creator's account doesn't delete or block the household.
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator User?         @relation("GroupCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  members GroupMember[]
  invites GroupInvite[]

  @@map("groups")
}

model GroupMember {
  groupId  String    @map("group_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  role     GroupRole @default(member)
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

/// One row per (group, email). Re-inviting sets the row back to `pending` (upsert), so the table doubles as history.
/// Matching rule: an invite belongs to a user when `group_invites.email = users.email` (both lower-cased + trimmed, CHECK enforced).
model GroupInvite {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     String       @map("group_id") @db.Uuid
  email       String
  invitedBy   String?      @map("invited_by") @db.Uuid
  status      InviteStatus @default(pending)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set on accept / decline / revoke; NULL while pending (CHECK enforced).
  respondedAt DateTime?    @map("responded_at") @db.Timestamptz(6)

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter User? @relation("InviteInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([groupId, email])
  @@index([email, status])
  @@map("group_invites")
}
