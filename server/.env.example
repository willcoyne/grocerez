# ── Database ───────────────────────────────────────────────────────────────────
# Local Postgres from docker-compose.yml. Locally the owner role is used for everything.
DATABASE_URL=postgresql://grocerez:grocerez@localhost:5432/grocerez

# Optional locally: run the API as the least-privilege role (create it with `npm run db:app-role`):
# DATABASE_URL=postgresql://grocerez_app:grocerez_app@localhost:5432/grocerez
# MIGRATE_DATABASE_URL=postgresql://grocerez:grocerez@localhost:5432/grocerez

# Production (set in the host's secret settings, never committed):
# DATABASE_URL=postgresql://grocerez_app:<strong-password>@<host>:5432/<db>?sslmode=require          # API runtime
# MIGRATE_DATABASE_URL=postgresql://<owner>:<owner-password>@<host>:5432/<db>?sslmode=require        # migrate deploy / seed

# Seed only: email that receives the demo group's pending invite (defaults to teammate@example.com).
# DEMO_INVITE_EMAIL=

# Tests use a separate database (created once with `npm run db:test:setup`). Default shown.
# TEST_DATABASE_URL=postgresql://grocerez:grocerez@localhost:5432/grocerez_test

# ── API server (validated at startup by src/config.ts) ─────────────────────────
NODE_ENV=development
PORT=3000
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# All Google OAuth client IDs (Web, iOS, Android), comma-separated. Placeholder works for /dev/login-as only.
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com
# Deep-link base used in invite emails.
APP_LINK_BASE=grocerez://
# Browser origins allowed by CORS (Expo web dev server). Native apps send no Origin header.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Contact address in the User-Agent for SmartLabel / Open Food Facts requests.
CONTACT_EMAIL=team@grocerez.app
# Set to false to disable the cron jobs (recall import) in this process.
ENABLE_JOBS=true

# ── External services (optional in development; required when NODE_ENV=production) ──
# Claude (recipes, price estimates). Missing → those routes return 503 NOT_CONFIGURED.
ANTHROPIC_API_KEY=
# S3 uploads (presigned URLs). Missing → /uploads/presign returns 503 NOT_CONFIGURED.
AWS_REGION=us-east-2
S3_BUCKET=
# Optional: S3-compatible endpoint (Akamai Object Storage, e.g. https://us-ord-1.linodeobjects.com; set AWS_REGION=us-ord). Unset → AWS S3.
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: invite emails through Resend (stretch). Missing → invites are only shown in the app.
RESEND_API_KEY=
RESEND_FROM=GrocerEZ <invites@your-verified-domain.com>
# Optional: raises the openFDA rate limit for the daily recall import.
OPENFDA_API_KEY=
# Pantry Agent (challenge 01). Unset AGENT_URL → "Plan our week" returns 503 and the app falls back to recipes.
# AGENT_SHARED_SECRET must equal the one in agent/.env (openssl rand -hex 32).
AGENT_URL=
AGENT_SHARED_SECRET=
# Base URL the agent uses to call this API (compose: http://server:3000/api).
AGENT_PUBLIC_API_URL=http://localhost:3000/api
# Optional, production only: enables POST /api/dev/login-as with header x-demo-key: <DEMO_KEY> for judging.
DEMO_KEY=

# Akamai embeddings for semantic item search ("oreo" → Cookies). Without them, search uses spelling matches only.
AKAMAI_API_KEY=
# OpenAI-compatible Akamai base URL; /embeddings and /chat/completions are added to it.
AKAMAI_BASE_URL=https://ws.akamai-workshops.com/v1
AKAMAI_EMBEDDING_MODEL=hackathon-embedding
# Writes the short item descriptions that embeddings are built from.
AKAMAI_CHAT_MODEL=hackathon-chat
# Cosine distance cutoff for "related" items (lower = stricter).
SEMANTIC_MAX_DISTANCE=0.35
# Matched item: other product types must be this close (same type always shows first).
SEMANTIC_ITEM_MAX_DISTANCE=0.24
# Typed query: keep related items within this distance of the closest one.
SEMANTIC_RELATIVE_GAP=0.08
