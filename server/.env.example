NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://grocerez:grocerez@localhost:5432/grocerez
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated Google OAuth client IDs (iOS, Android, Web)
GOOGLE_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com
ANTHROPIC_API_KEY=sk-ant-your-key
AWS_REGION=us-east-1
S3_BUCKET=grocerez-uploads
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
APP_LINK_BASE=grocerez://
# Optional: invite emails (stretch goal)
RESEND_API_KEY=
# Optional: openFDA API key (raises the rate limit of the daily recall import)
OPENFDA_API_KEY=
# Optional: number of reverse proxies in front of the API. Set to 1 on Railway / Cloud Run; leave empty locally.
TRUST_PROXY=
